#!/usr/bin/env bash
# Thin wrapper so `queuectl <command>` works from anywhere once bin/ is on
# PATH. It just resolves the package directory and delegates to
# `python3 -m queuectl`, which is what __main__.py expects to be run as.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
REPO_ROOT="$(dirname -- "$SCRIPT_DIR")"

exec env PYTHONPATH="$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 -m queuectl "$@"
